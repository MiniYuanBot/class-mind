# ClassMind 环境变量模板 —— 复制为 .env 并填入你的密钥（.env 已被 gitignore）。
# CLI 会自动装载仓库根目录 .env；也可改为系统环境变量，二者任选其一。

# ---- 文本 LLM（DeepSeek / OpenAI 兼容）----
CLASSMIND_API_KEY=sk-your-deepseek-key
# CLASSMIND_LLM_BASE_URL=https://api.deepseek.com
# CLASSMIND_LLM_MODEL=deepseek-chat

# ---- 视觉图注（可选，Kimi / Moonshot 兼容端点）----
# 提示：先用下方命令确认你的账号可用模型，再把可用的视觉模型填入 CLASSMIND_VISION_MODEL
#   curl -H "Authorization: Bearer $CLASSMIND_VISION_API_KEY" https://api.moonshot.cn/v1/models
CLASSMIND_VISION_API_KEY=sk-your-vision-key
# CLASSMIND_VISION_BASE_URL=https://api.moonshot.cn/v1
# CLASSMIND_VISION_MODEL=kimi-k3
